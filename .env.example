# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml for local dev; use your Neon URL in production)
POSTGRES_USER=ghostjob
POSTGRES_PASSWORD=ghostjob
POSTGRES_DB=ghostjob
DATABASE_URL=postgresql://ghostjob:ghostjob@localhost:5432/ghostjob

# API
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM (Phase 5): provider = anthropic | openai | ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_DAILY_COST_CAP_USD=1.00

# Market data (Phase 1+)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
